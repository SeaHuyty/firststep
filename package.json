{
  "name": "wealthpilot",
  "private": true,
  "description": "WealthPilot AI prototype: Next.js client + FastAPI server",
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "cd server && python -m uvicorn app.main:app --reload --port 8000",
    "build:client": "npm --prefix client run build",
    "lint:client": "npm --prefix client run lint",
    "test:server": "cd server && python -m pytest -q"
  }
}
