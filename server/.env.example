# Copy to .env. Without any key the app runs on the scripted fake model (LLM_PROVIDER=fake).
LLM_PROVIDER=fake

# OpenRouter: a fallback chain, tried in order. Use models that support tool calling.
# Free (":free") models cost nothing: 20 requests a minute, 50 a day on an account that never
# bought credits. Free models change often; check https://openrouter.ai/models (filter: FREE +
# tools), and allow free endpoints at https://openrouter.ai/settings/privacy or they are skipped.
# Give the key "No limit" (a $0 limit blocks every request) and an expiry date.
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-s-2.1:free,openrouter/free

# Or one direct provider:
# ANTHROPIC_API_KEY=
# Google AI Studio (free tier; check https://aistudio.google.com/rate-limit for your limits).
# Gemma 4 had 14,400 free requests a day in Oct 2026 and calls tools; a list falls back in order.
# 26b-a4b runs about 4B parameters per word, so it answers faster than 31b.
# LLM_PROVIDER=google
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemma-4-26b-a4b-it,gemma-4-31b-it,gemma-4-26b-a4b-it

# Seconds a typed turn may take in the web app (default 45; keep it under 75, the web proxy's
# limit). The evidence scripts allow at least 120.
# LLM_TURN_TIMEOUT_S=45

# Signs one-time confirmation tokens. Set a long random value outside local development:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONFIRM_SECRET=dev-only-change-me
