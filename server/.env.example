# Copy to .env. Pick ONE provider. Gemini has a free tier: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional model overrides:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Live product data (Yahoo Finance via yfinance). Set MARKET_ENABLED=false to use static catalog figures only.
# MARKET_ENABLED=true
# MARKET_TTL_SECONDS=1800
