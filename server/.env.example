# Copy to .env. Without any key the app runs on the scripted fake model (LLM_PROVIDER=fake).
LLM_PROVIDER=fake

# OpenRouter: a fallback chain, tried in order. Use models that support tool calling;
# open-weight free models are fine for demos (check https://openrouter.ai/models?supported_parameters=tools).
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=qwen/qwen3-235b-a22b:free,deepseek/deepseek-chat-v3.1:free,meta-llama/llama-3.3-70b-instruct:free

# Or one direct provider:
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Signs one-time confirmation tokens. Set a long random value outside local development:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONFIRM_SECRET=dev-only-change-me
