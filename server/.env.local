# =============================================================================
# WealthPilot server — local environment configuration
# =============================================================================
# This file is read by app/config.py. It is named ".env.local" (not ".env")
# because the virtualenv in this folder is a directory already named ".env".
#
# Keep this file private. Do NOT commit it. (It is covered by .gitignore.)

# -----------------------------------------------------------------------------
# AI provider: OpenRouter  (https://openrouter.ai/keys)
# -----------------------------------------------------------------------------
# Paste your OpenRouter API key below (it starts with "sk-or-").
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# Which model OpenRouter should route to. See https://openrouter.ai/models
# OPENROUTER_CHAT_MODEL is used for fast chat turns; OPENROUTER_MODEL for
# higher-quality explanations. Use any slug OpenRouter supports, e.g.:
#   openai/gpt-4o              anthropic/claude-3.5-sonnet
#   openai/gpt-4o-mini         google/gemini-2.0-flash-001
#   meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# -----------------------------------------------------------------------------
# Other providers (leave blank — OpenRouter takes precedence when its key is set)
# -----------------------------------------------------------------------------
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Live market data (Yahoo Finance via yfinance)
# -----------------------------------------------------------------------------
# MARKET_ENABLED=true
# MARKET_TTL_SECONDS=1800
